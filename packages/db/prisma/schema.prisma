generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Tenancy & Auth ─────────────────────────────────────────────

enum AccountType {
  PERSONAL
  BUSINESS
}

enum CompanyPlan {
  STARTER
  GROWTH
  BUSINESS
}

model Company {
  id                    String       @id @default(cuid())
  name                  String
  slug                  String?      @unique
  accountType           AccountType?
  plan                  CompanyPlan  @default(BUSINESS)
  onboardingCompletedAt DateTime?
  logoUrl               String?
  primaryColor          String?
  address               String?
  country               String?
  defaultCurrency       String       @default("USD")
  phone                 String?
  website               String?
  industry              String?
  taxId                 String?
  contactEmail          String?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  users             User[]
  memberships       CompanyMembership[]
  entitlements      Entitlement[]
  employees         Employee[]
  attendanceRecords AttendanceRecord[]
  attendanceEvents  AttendanceEvent[]
  payrollRuns       PayrollRun[]
  loans             Loan[]
  sinkingFunds      SinkingFund[]
  inventoryItems    InventoryItem[]
  customers         Customer[]
  invoices          Invoice[]
}

enum UserRole {
  OWNER
  ADMIN
  HR_MANAGER
  HR_ASSISTANT
  TREASURER
  MEMBER
}

model User {
  id                 String   @id @default(cuid())
  companyId          String
  company            Company  @relation(fields: [companyId], references: [id])
  email              String   @unique
  fullName           String
  passwordHash       String?
  role               UserRole @default(OWNER)
  mustChangePassword Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  oauthAccounts      OAuthAccount[]
  employeeRecord     Employee?
  companyMemberships CompanyMembership[]
}

// links an owner/admin account to an additional company they can switch into,
// beyond the one company every User row already belongs to via companyId
model CompanyMembership {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  role      UserRole @default(OWNER)
  createdAt DateTime @default(now())

  @@unique([userId, companyId])
  @@index([userId])
  @@index([companyId])
}

enum OAuthProvider {
  GOOGLE
  FACEBOOK
}

model OAuthAccount {
  id                String        @id @default(cuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id])
  provider          OAuthProvider
  providerAccountId String
  createdAt         DateTime      @default(now())

  @@unique([provider, providerAccountId])
}

model Entitlement {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  module    String
  active    Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@unique([companyId, module])
}

// ─── People ─────────────────────────────────────────────────────

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  TERMINATED
}

enum ShiftSchedule {
  DAY_SHIFT
  NIGHT_SHIFT
  MID_SHIFT
}

model Employee {
  id                 String          @id @default(cuid())
  companyId          String
  company            Company         @relation(fields: [companyId], references: [id])
  employeeCode       String
  fullName           String
  profileImageUrl    String?
  email              String?
  companyEmail       String?
  phone              String?
  dateOfBirth        DateTime?
  address            String?
  position           String?
  department         String?
  employmentType     EmploymentType?
  shiftSchedule      ShiftSchedule?
  hireDate           DateTime?
  baseSalary         Decimal?        @db.Decimal(12, 2)
  baseSalaryCurrency String?         @default("USD")

  emergencyContactName  String?
  emergencyContactPhone String?

  bankName              String?
  bankAccountNumber     String?
  bankAccountHolderName String?

  status    EmployeeStatus @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  attendanceRecords AttendanceRecord[]
  attendanceEvents  AttendanceEvent[]
  payslips          Payslip[]
  loans             Loan[]
  sinkingFundMemberships SinkingFundMember[]

  @@unique([companyId, employeeCode])
  @@index([companyId])
}

// ─── Attendance ─────────────────────────────────────────────────

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  LEAVE
}

model AttendanceRecord {
  id         String           @id @default(cuid())
  companyId  String
  company    Company          @relation(fields: [companyId], references: [id])
  employeeId String
  employee   Employee         @relation(fields: [employeeId], references: [id])
  date       DateTime
  status     AttendanceStatus
  createdAt  DateTime         @default(now())

  @@unique([employeeId, date])
  @@index([companyId])
}

enum AttendanceEventType {
  CLOCK_IN
  CLOCK_OUT
  BREAK_START
  BREAK_END
}

model AttendanceEvent {
  id         String              @id @default(cuid())
  companyId  String
  company    Company             @relation(fields: [companyId], references: [id])
  employeeId String
  employee   Employee            @relation(fields: [employeeId], references: [id])
  type       AttendanceEventType
  occurredAt DateTime            @default(now())
  createdAt  DateTime            @default(now())

  @@index([companyId])
  @@index([employeeId])
}

// ─── Payroll ────────────────────────────────────────────────────

enum PayrollRunStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model PayrollRun {
  id          String           @id @default(cuid())
  companyId   String
  company     Company          @relation(fields: [companyId], references: [id])
  periodStart DateTime
  periodEnd   DateTime
  status      PayrollRunStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  payslips Payslip[]

  @@index([companyId])
}

model Payslip {
  id           String     @id @default(cuid())
  payrollRunId String
  payrollRun   PayrollRun @relation(fields: [payrollRunId], references: [id])
  employeeId   String
  employee     Employee   @relation(fields: [employeeId], references: [id])
  grossPay     Decimal    @db.Decimal(12, 2)
  deductions   Decimal    @default(0) @db.Decimal(12, 2)
  netPay       Decimal    @db.Decimal(12, 2)
  createdAt    DateTime   @default(now())

  @@unique([payrollRunId, employeeId])
}

// ─── Loans ──────────────────────────────────────────────────────

enum LoanStatus {
  ACTIVE
  PAID_OFF
  DEFAULTED
}

enum LoanFundSource {
  PERSONAL
  SINKING_FUND
}

model Loan {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  fundSource    LoanFundSource @default(PERSONAL)
  sinkingFundId String?
  sinkingFund   SinkingFund?   @relation(fields: [sinkingFundId], references: [id])

  employeeId          String?
  employee            Employee?          @relation(fields: [employeeId], references: [id])
  sinkingFundMemberId String?
  sinkingFundMember   SinkingFundMember? @relation(fields: [sinkingFundMemberId], references: [id])
  manualBorrowerName  String?

  principal    Decimal    @db.Decimal(12, 2)
  interestRate Decimal    @default(0) @db.Decimal(5, 2)
  termMonths   Int
  status       LoanStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  repayments LoanRepayment[]

  @@index([companyId])
  @@index([sinkingFundId])
  @@index([employeeId])
  @@index([sinkingFundMemberId])
}

model LoanRepayment {
  id     String   @id @default(cuid())
  loanId String
  loan   Loan     @relation(fields: [loanId], references: [id])
  amount Decimal  @db.Decimal(12, 2)
  paidAt DateTime @default(now())

  @@index([loanId])
}

// ─── Sinking Funds ──────────────────────────────────────────────

enum SinkingFundFrequency {
  WEEKLY
  SEMI_MONTHLY
  MONTHLY
}

model SinkingFund {
  id              String               @id @default(cuid())
  companyId       String
  company         Company              @relation(fields: [companyId], references: [id])
  name            String
  slug            String               @unique
  frequency       SinkingFundFrequency
  amountPerMember Decimal              @db.Decimal(12, 2)
  startDate       DateTime
  releaseDate     DateTime
  qrCodeUrl       String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  members SinkingFundMember[]
  loans   Loan[]

  @@index([companyId])
}

model SinkingFundMember {
  id                 String      @id @default(cuid())
  sinkingFundId      String
  sinkingFund        SinkingFund @relation(fields: [sinkingFundId], references: [id])
  employeeId         String?
  employee           Employee?   @relation(fields: [employeeId], references: [id])
  manualName         String?
  manualMobile       String?
  manualEmail        String?
  memberCode         String
  passwordHash       String?
  mustChangePassword Boolean     @default(true)
  createdAt          DateTime    @default(now())

  contributions SinkingFundContribution[]
  loans         Loan[]

  @@unique([sinkingFundId, memberCode])
  @@index([sinkingFundId])
  @@index([employeeId])
}

model SinkingFundContribution {
  id       String            @id @default(cuid())
  memberId String
  member   SinkingFundMember @relation(fields: [memberId], references: [id])
  dueDate  DateTime
  amount   Decimal           @db.Decimal(12, 2)
  paid     Boolean           @default(false)
  paidAt   DateTime?

  @@unique([memberId, dueDate])
  @@index([memberId])
}

// ─── Inventory ──────────────────────────────────────────────────

model InventoryItem {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  sku       String
  name      String
  quantity  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, sku])
}

// ─── Invoicing ──────────────────────────────────────────────────

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  VOID
}

model Customer {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  email     String?
  createdAt DateTime @default(now())

  invoices Invoice[]

  @@index([companyId])
}

model Invoice {
  id         String        @id @default(cuid())
  companyId  String
  company    Company       @relation(fields: [companyId], references: [id])
  customerId String
  customer   Customer      @relation(fields: [customerId], references: [id])
  status     InvoiceStatus @default(DRAFT)
  dueDate    DateTime
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  lineItems InvoiceLineItem[]

  @@index([companyId])
}

model InvoiceLineItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id])
  description String
  quantity    Decimal @db.Decimal(12, 2)
  unitPrice   Decimal @db.Decimal(12, 2)
}
