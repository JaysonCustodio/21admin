NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
WEB_APP_URL=http://localhost:3000

DATABASE_URL=postgresql://user:password@localhost:5432/business_platform
REDIS_URL=redis://localhost:6379

JWT_SECRET=changeme

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

STRIPE_SECRET_KEY=sk_test_changeme
STRIPE_WEBHOOK_SECRET=whsec_changeme

# GCash checkout + payout via Xendit (sandbox) — leave blank to disable
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
# your own GCash-registered mobile number, e.g. 09171234567 — where plan
# upgrade payments get disbursed to after collection
XENDIT_PAYOUT_GCASH_NUMBER=

# Cloudflare R2 for uploaded files (logos, employee photos, QR codes) — leave
# blank to store uploads on local disk instead (fine for local dev, but lost
# on redeploy on a host with an ephemeral disk, e.g. Render's free tier)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# the bucket's public base URL (r2.dev subdomain or a custom domain), no trailing slash
R2_PUBLIC_URL=

NEXT_PUBLIC_API_URL=http://localhost:4000
# the web app's own public URL — used for SEO metadata (canonical/OG URLs, sitemap, robots.txt)
SITE_URL=http://localhost:3000
